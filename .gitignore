node_modules/
*.log
.DS_Store
.agents/drafts
# The dashboard is built from source (`pnpm --filter web build`); the bundle is a
# local artifact, not something to review in a diff.
web/dist/
# The offline fixture and the screenshots are dumps of *this* machine's usage:
# real paths, session titles and amounts. They are generated on demand
# (`pnpm web:snapshot`, see web/mock/README.md) and deliberately not tracked.
web/mock/dashboard.snapshot.json
web/mock/screenshots/
# The scratch configuration the smoke/e2e servers run against, so a test that
# switches the language never writes the developer's own config.json.
web/.tmp/
# Playwright's run artifacts: traces, videos and the failure-only HTML report.
web/test-results/
web/playwright-report/
# `playwright-cli` drops page snapshots here when driving the app by hand.
.playwright-cli/
