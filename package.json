{
  "name": "@agent/usages",
  "version": "0.2.0",
  "private": true,
  "description": "统计 coding agent 的 token 消耗与费用：agent 与模型价格两个维度均可扩展，支持项目/会话/子代理维度、时间范围与分时段峰谷定价",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "bin": {
    "agent-usages": "./bin/agent-usages.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./agents": "./src/agents/index.ts",
    "./pricing": "./src/pricing/index.ts"
  },
  "scripts": {
    "cli": "node src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "string-width": "^8.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
